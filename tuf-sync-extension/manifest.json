{
  "manifest_version": 3,
  "name": "FAANG Tracker - TUF Sync",
  "version": "2.0",
  "description": "Auto-syncs your TakeUForward accepted submissions to your FAANG Tracker dashboard in real-time.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://takeuforward.org/*",
    "https://firestore.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://takeuforward.org/plus/dsa/*"],
      "js": ["slug-map.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FAANG Tracker Sync"
  }
}
